<% layout("/layouts/boilerplate") -%>

    <body>
        <div class="row mt-3">
            <div class="col-8 offset-3">
                <h3>
                    <%= listing.title %>
                </h3>
            </div>
            <div class="card col-6 offset-3 show-card">
                <img src="<%= listing.image %>" class="card-img-top show-img" alt="...">
                <div class="card-body">
                    <p class="card-text">
                        <%= listing.description %>
                            <br>
                            NPR <%= listing.price.toLocaleString('en-NP') %><br>
                                <%= listing.location %>, <%= listing.country %>
                    </p>
                </div>
            </div>
            <div class="btns">
                <a href="/listings/<%= listing.id %>/edit" class="btn btn-dark col-1 offset-3 edit-btn">Edit </a>
                <form method="POST" action="/listings/<%= listing.id %>?_method=DELETE">
                    <button class="btn btn-dark offset-4"> Delete </button>
                </form>
            </div>
        </div>

        <div class="col-8 offset-3 mb-3 mt-3">
            <hr />
            <h4>Leave a Review </h4>
            <form>
                <div class="mb-3 mt-3">
                    <label class="form-label">Rating</label>
                    <input type="range" min="1" max="5" name="review[rating]" class="form-range">
                </div>
                <div class="mb-3 mt-3">
                    <label class="form-label">Comment</label>
                    <textarea name="review[comment]" id="comment" cols="30" , rows="5" class="form-control"></textarea>
                </div>
                <button class="btn btn-outline-dark mb-3 mt-3">Submit</button>
            </form>
        </div>
    </body>