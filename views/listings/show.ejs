<% layout("/layouts/boilerplate") -%>

    <body>
        <div class="row mt-3">
            <div class="col-8 offset-3">
                <h3>
                    <%= listing.title %>
                </h3>
            </div>
            <div class="card col-6 offset-3 show-card listing-card">
                <img src="<%= listing.image %>" class="card-img-top show-img" alt="...">
                <div class="card-body">
                    <p class="card-text">
                        <%= listing.description %>
                            <br>
                            NPR <%= listing.price.toLocaleString('en-NP') %><br>
                                <%= listing.location %>, <%= listing.country %>
                    </p>
                </div>
            </div>
            <div class="btns">
                <a href="/listings/<%= listing.id %>/edit" class="btn btn-dark col-1 offset-3 edit-btn">Edit </a>
                <form method="POST" action="/listings/<%= listing.id %>?_method=DELETE">
                    <button class="btn btn-dark offset-4"> Delete </button>
                </form>
            </div>
        </div>

        <div class="col-8 offset-3 mb-3 mt-3">
            <hr />
            <h4>Leave a Review </h4>
            <form action="/listings/<%= listing.id %>/review" method="POST">
                <div class="mb-3 mt-3">
                    <label class="form-label">Rating</label>
                    <input type="range" min="1" max="5" name="review[rating]" class="form-range">
                </div>
                <div class="mb-3 mt-3">
                    <label class="form-label">Comment</label>
                    <textarea name="review[comment]" id="comment" cols="30" , rows="5" class="form-control"
                        required></textarea>
                </div>
                <button class="btn btn-outline-dark mb-3 mt-3">Submit</button>
            </form>
        </div>


        <hr />

        <p><b>All Reviews</b></p>

        <% if (listing.reviews.length> 0) { %>
            <div class="row">
                <% for (review of listing.reviews) { %>
                    <div class="col-6 mb-3">
                        <div class="card border border-dark" style="padding: 10px;">
                            <div class="card-body">
                                <h5 class="card-title">Jane Roi</h5>

                                <p class="class-text">
                                    <%= review.comment %>
                                </p>

                                <p class="class-text">
                                    <%= review.rating %> Star Rating
                                </p>
                                <form method="POST" action="/listings/<%= listing.id %>/reviews/<%= review.id %>?_method=DELETE">
                                    <button class="btn btn-dark">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                    <% } %>
            </div>
            <% } else { %>
                <p>No Review Yet</p>
                <% } %>
                