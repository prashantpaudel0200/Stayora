<% layout("/layouts/boilerplate") -%>


    <body>
        <div class="row row-cols-lg-3">
            <% for(let listings of allListings) { %>
                <div class="card "  style="width: 20rem;">
                    <a href="/listings/<%= listings._id %>" style="text-decoration: none; color: black;">
                        <img src="<%= listings.image.url %>" class="card-img-top" alt="Listing" style="height: 20rem;">
                        <div class="card-img-overlay"></div>
                        <div class="card-body">
                            <p class="class-text">
                                <b>
                                    <%= listings.title %>
                                </b><br>
                                NPR <%= listings.price.toLocaleString('en-NP') %> / night
                            </p>
                        </div>
                    </a>
                </div>

                <% } %>
        </div>
    </body>